{
  "name": "felix-portfolio-workshop",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tailwindcss -i ./styles/input.css -o ./assets/site.css --minify",
    "build:site": "npm run build && node scripts/prepare-site.mjs",
    "watch": "tailwindcss -i ./styles/input.css -o ./assets/site.css --watch",
    "optimize:assets": "node scripts/optimize-assets.mjs"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@tailwindcss/cli": "4.3.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.0"
  }
}
